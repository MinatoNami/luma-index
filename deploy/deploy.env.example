# ==============================================================================
# LumaIndex — deploy target (LOCAL machine only)
# ==============================================================================
# Copy to `deploy/deploy.env` and edit. This file describes *where* to deploy;
# `.env.example` at the repo root describes *what the app needs* once it is
# there. deploy/deploy.env is gitignored — it names your host, nothing secret.
#
#   cp deploy/deploy.env.example deploy/deploy.env
# ==============================================================================

# Tailscale MagicDNS name or IP of the Ubuntu server.
DEPLOY_HOST=luma.your-tailnet.ts.net

# SSH user. Must be able to sudo (bootstrap) and be in the `docker` group.
DEPLOY_USER=ubuntu

DEPLOY_PORT=22

# Optional explicit identity file. Leave blank to use your ssh-agent/config.
DEPLOY_SSH_KEY=

# Where the app lives on the server. Contains releases/, shared/, backups/.
DEPLOY_PATH=/opt/lumaindex

# How code gets to the server:
#   rsync — push your working tree (fast, no server-side git credentials).
#   git   — the server clones/pulls from the remote below (reproducible; needs
#           a deploy key on the server for a private repo).
DEPLOY_METHOD=rsync

# Only used when DEPLOY_METHOD=git.
DEPLOY_GIT_URL=git@github.com:MinatoNami/luma-index.git
DEPLOY_GIT_REF=main

# How many past releases to keep on disk for rollback.
DEPLOY_KEEP_RELEASES=5

# ------------------------------------------------------------------------------
# Backups — all of this lands on THIS machine, not the server.
# ------------------------------------------------------------------------------

# Where backups are written. Defaults to backups/ in the repo, which is
# gitignored. Point it at an external disk, a NAS mount, or a synced folder:
# two copies in one building is one copy.
BACKUP_DIR=

# How many database dumps to keep. The library mirror is never rotated — it is
# not a series of snapshots, it is the copy of the files.
BACKUP_KEEP=14
