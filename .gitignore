# Secrets — never commit
.env
.env.*
!.env.example
deploy/deploy.env
deploy/*.env
!deploy/deploy.env.example
*.pem
*.key
!**/id_*.pub

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.sqlite3

# Copied from node_modules during the frontend build
frontend/public/cmaps/

# Playwright leaves traces and reports next to the tests; both are artefacts
# of a run, and a trace.zip is a megabyte of it.
frontend/test-results/
frontend/playwright-report/

# Node / Nuxt
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/

# Runtime data (bind-mounted or volume-backed)
data/
backups/

# Build artefacts the container writes back through a bind mount: collectstatic
# output, and pip's user site when dev requirements are installed into a
# running container. Both are regenerated, and both are tens of megabytes.
backend/staticfiles/
backend/.local/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
