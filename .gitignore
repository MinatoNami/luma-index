# Secrets — never commit.
#
# Matched anywhere in the tree, not just where they are expected today: a
# secret in a directory these patterns did not anticipate is the failure that
# actually happens, and this repository is public.
.env
.env.*
!.env.example
*.env
!*.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
!**/id_*.pub

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.sqlite3

# Copied from node_modules during the frontend build
frontend/public/cmaps/

# The seeded design canvas: a 2.5 MB payload rebuilt from design/*.dc.html by
# the design skill's helper. The artboards are the source; this is the build.
design/lumaindex-ui.html
design/_shared.txt

# Playwright leaves traces and reports next to the tests; both are artefacts
# of a run, and a trace.zip is a megabyte of it.
frontend/test-results/
frontend/playwright-report/

# Node / Nuxt
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/

# Runtime data (bind-mounted or volume-backed)
data/
backups/

# Build artefacts the container writes back through a bind mount: collectstatic
# output, and pip's user site when dev requirements are installed into a
# running container. Both are regenerated, and both are tens of megabytes.
backend/staticfiles/
backend/.local/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
