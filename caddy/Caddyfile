# LumaIndex reverse proxy.
#
# Caddy listens on plain HTTP and is published to 127.0.0.1 only. TLS is
# terminated by `tailscale serve` on the host, which gives us a real
# certificate for the MagicDNS name without exposing a single port to the LAN
# or the internet. See deploy/bootstrap.sh.

{
	admin off

	# No ACME: this listener is HTTP by design and there is no public DNS to
	# validate against. Leaving it on would produce cert-request failures.
	auto_https off

	# `tailscale serve` sets X-Forwarded-Proto: https. Without trusting the
	# proxy, Caddy would overwrite it with "http" and Django would then refuse
	# to set Secure cookies — logins would appear to succeed and do nothing.
	servers {
		trusted_proxies static private_ranges 127.0.0.1/32 ::1
	}
}

:8080 {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# Django owns the API, the admin, and admin static files.
	@django path /api/* /admin/* /static/*
	handle @django {
		reverse_proxy backend:8000 {
			# PDFs stream through Django's authorization boundary and can be
			# large; do not let the proxy time out mid-download.
			transport http {
				response_header_timeout 30s
				read_timeout 600s
			}
		}
	}

	# Everything else is the Nuxt app.
	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
