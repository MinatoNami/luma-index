# ==============================================================================
# LumaIndex — application environment
# ==============================================================================
# Copy to `.env` and fill in. This file lives on the SERVER; the deploy script
# uploads it for you. Never commit it, and generate every secret below rather
# than reusing an example.
#
#   cp .env.example .env && chmod 600 .env
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Public origin
# ------------------------------------------------------------------------------
# The single origin users hit in the browser — Caddy routes /api, /admin and
# /static to Django and everything else to Nuxt. Same-origin is deliberate: it
# keeps the session cookie simple and removes CORS entirely.
#
# This is your Tailscale MagicDNS name (`tailscale status`), including the port
# if `tailscale serve` is not on 443. TLS is terminated by `tailscale serve`.
LUMA_PUBLIC_ORIGIN=https://luma.your-tailnet.ts.net


# ------------------------------------------------------------------------------
# 2. Django core
# ------------------------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string

# Never True on the server.
DJANGO_DEBUG=False

# Comma-separated, and must include your MagicDNS name. Django rejects requests
# with an unlisted Host header — the most common cause of a 400 after deploy.
DJANGO_ALLOWED_HOSTS=luma.your-tailnet.ts.net,localhost,127.0.0.1,backend

# Comma-separated, scheme required, port included if there is one. Must match
# LUMA_PUBLIC_ORIGIN exactly or logins fail CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://luma.your-tailnet.ts.net

# DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 3. Session and CSRF cookies
# ------------------------------------------------------------------------------
# Set BOTH to False when serving over plain HTTP. A Secure cookie is never sent
# over HTTP, so leaving these True gives a login that appears to succeed and
# then does nothing.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Seconds. 1209600 = 14 days.
DJANGO_SESSION_COOKIE_AGE=1209600

# HSTS. 0 sends no header, which is deliberate for a tailnet-only instance:
# the name resolves only inside the tailnet, so there is no downgrade to protect
# against, and a browser that pins HSTS will refuse plain HTTP to this host for
# the full duration even after you stop serving TLS. If this ever answers on a
# public name, raise it in stages (300, a day, a year) rather than starting
# high.
DJANGO_SECURE_HSTS_SECONDS=0
# Only once every subdomain of that name is also on TLS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False


# ------------------------------------------------------------------------------
# 4. PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=lumaindex
POSTGRES_USER=lumaindex
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Seconds a connection is reused before reopening. The connection count is
# GUNICORN_WORKERS x GUNICORN_THREADS — keep that product under Postgres's
# max_connections (100 by default).
POSTGRES_CONN_MAX_AGE=60


# ------------------------------------------------------------------------------
# 5. Email  (required for password reset — PRD §7)
# ------------------------------------------------------------------------------
# `console` prints reset links to the backend log instead of sending mail. Fine
# for a single-user instance; switch to `smtp` before a second person has an
# account.  console | smtp
LUMA_EMAIL_BACKEND=console

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Leave both blank and the port decides: 587 STARTTLS, 465 implicit TLS. Set one
# only to override that, never both — the app refuses to start rather than
# quietly picking for you.
EMAIL_USE_TLS=
EMAIL_USE_SSL=

# Seconds to wait on the relay. Sending happens inside the request, so an
# unreachable relay holds a worker open this long on every attempt.
EMAIL_TIMEOUT=10

# Most relays only accept a domain they know, and reject anything @localhost.
DEFAULT_FROM_EMAIL=lumaindex@your-tailnet.ts.net

# Where Django's own error mail comes from. Defaults to DEFAULT_FROM_EMAIL.
SERVER_EMAIL=

# Seconds a password reset link stays valid. One hour.
LUMA_PASSWORD_RESET_TIMEOUT=3600

# Check the relay without locking anyone out to find out:
#   ./deploy/deploy.sh manage check_email you@example.com


# ------------------------------------------------------------------------------
# 6. Rate limiting and proxy trust
# ------------------------------------------------------------------------------
# How many proxies sit in front of Django. SECURITY-RELEVANT: this decides which
# hop of X-Forwarded-For is trusted as the client address. Too high and a client
# can forge its own identity, defeating rate limiting; too low and every user
# shares one bucket.
#
#   2 = tailscale serve -> caddy -> django   (this deployment)
#   1 = caddy -> django                      (local dev)
#
# Verify after any topology change: set LUMA_LOG_CLIENT_IP=True, fail a login,
# and check `./deploy/deploy.sh logs backend` shows your real address.
LUMA_NUM_PROXIES=2

# Log the resolved client address on authentication failures (PRD §41).
LUMA_LOG_CLIENT_IP=False

# Per-address, then per-targeted-account. The second caps credential stuffing
# against one user even if address attribution is wrong.
LUMA_THROTTLE_AUTH=10/min
LUMA_THROTTLE_LOGIN_EMAIL=5/min


# ------------------------------------------------------------------------------
# 7. Registration policy
# ------------------------------------------------------------------------------
# PRD non-goal: no public registration unless explicitly enabled. Keep this
# False and create accounts from Django Admin.
LUMA_REGISTRATION_ENABLED=False


# ------------------------------------------------------------------------------
# 8. Storage
# ------------------------------------------------------------------------------
# Paths INSIDE the backend container, backed by named docker volumes.
#
# LUMA_LIBRARY_DIR holds the uploaded PDFs and is CANONICAL — nothing in it can
# be regenerated from anywhere else, so back the `library` volume up alongside
# the database. Thumbnails re-render from it; staging is scratch.
LUMA_LIBRARY_DIR=/data/library
LUMA_THUMBNAIL_DIR=/data/thumbnails
LUMA_UPLOAD_STAGING_DIR=/data/staging

# Largest single upload, PDF or ZIP, in bytes. 2 GiB.
LUMA_MAX_UPLOAD_BYTES=2147483648

# Refuse uploads that would leave less than this free. 2 GiB. Storage cannot be
# evicted the way a cache can, and a full disk stops PostgreSQL accepting
# writes — so the whole instance goes down, not just uploads.
LUMA_MIN_FREE_DISK_BYTES=2147483648

# Per-account storage limit in bytes; 0 means unlimited. The disk floor above
# stops the disk filling but not one account being what fills it, so set this
# before a second person has an account. What counts: the distinct files an
# account's books point at, trash included — the same PDF filed twice costs one
# copy, and another user holding the same file does not make yours free.
# Individual allowances go in the admin, where blank means "use this default".
#
# 20 GiB = 21474836480
LUMA_DEFAULT_USER_QUOTA_BYTES=0

# Days a trashed item is kept before the worker destroys it; 0 means never.
#
# This is the only setting that deletes a file nobody asked it to delete, and
# storage here is canonical — the PDF in somebody's trash may be their only
# copy. Turned on, it stops the trash being where quota hides.
#
# Run `manage.py empty_trash --dry-run` before enabling it: the first sweep
# deletes everything already past the cutoff, not just things trashed from now.
#
# 30 days = 30
LUMA_TRASH_RETENTION_DAYS=0

# How long a browser may reuse a downloaded book before checking again. The
# check is a 304 against the file's own SHA-256, so this only decides how often
# that round trip happens — the bytes are reused either way.
LUMA_BOOK_CACHE_SECONDS=3600


# ------------------------------------------------------------------------------
# 9. Runtime tuning
# ------------------------------------------------------------------------------
# Rule of thumb: (2 * CPU cores) + 1.
GUNICORN_WORKERS=3

# Concurrency is workers x threads, and so is the Postgres connection count.
#
# gthread rather than sync on purpose: with sync workers GUNICORN_TIMEOUT caps
# the whole request including the time spent receiving an upload, so a large
# file dies mid-stream. With threads that timeout is a liveness heartbeat.
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=120

# Tag applied to built images. deploy.sh sets this per release so the previous
# release's images stay on disk and `deploy.sh rollback` works.
LUMA_IMAGE_TAG=latest

# Where Caddy is published on the host. The default binds to loopback only, so
# the sole way in is `tailscale serve`. Setting 0.0.0.0 exposes LumaIndex to
# every network the host is attached to, including the public internet if it has
# a routable address.
LUMA_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=8080


# ------------------------------------------------------------------------------
# 10. First-run superuser (optional)
# ------------------------------------------------------------------------------
# If both are set, the backend creates this account on first start and then
# ignores them. Blank them afterwards — or just run:
#   ./deploy/deploy.sh createsuperuser
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
