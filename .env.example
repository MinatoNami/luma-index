# ==============================================================================
# LumaIndex — application environment
# ==============================================================================
# Copy to `.env` and fill in. This file lives on the SERVER (the deploy script
# uploads it for you on first run) and is read by docker compose.
#
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit `.env`. Generate every secret below — do not reuse the examples.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Public origin
# ------------------------------------------------------------------------------
# The single origin users hit in the browser. Both Nuxt and Django are served
# from here — Caddy routes /api, /admin and /static to Django, everything else
# to Nuxt. Same-origin is deliberate: it keeps the session cookie simple and
# removes CORS from the picture entirely.
#
# This is your Tailscale MagicDNS name. Find it with:  tailscale status
# TLS is terminated by `tailscale serve`, set up by deploy/bootstrap.sh.
LUMA_PUBLIC_ORIGIN=https://luma.your-tailnet.ts.net


# ------------------------------------------------------------------------------
# 2. Django core
# ------------------------------------------------------------------------------
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string

# Never True on the server.
DJANGO_DEBUG=False

# Comma-separated. Must include your MagicDNS name. Django rejects requests
# with an unlisted Host header — this is the #1 cause of a 400 after deploy.
DJANGO_ALLOWED_HOSTS=luma.your-tailnet.ts.net,localhost,127.0.0.1,backend

# Comma-separated, scheme required. Must match LUMA_PUBLIC_ORIGIN exactly.
DJANGO_CSRF_TRUSTED_ORIGINS=https://luma.your-tailnet.ts.net

# Django's logging verbosity: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 3. Session & CSRF cookies
# ------------------------------------------------------------------------------
# Set BOTH to False if you are serving over plain HTTP (CADDY_SITE_ADDRESS=:80).
# A Secure cookie is never sent over HTTP, so leaving these True on an HTTP
# deployment produces a login that appears to succeed and then does nothing.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Seconds. 1209600 = 14 days.
DJANGO_SESSION_COOKIE_AGE=1209600


# ------------------------------------------------------------------------------
# 4. PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=lumaindex
POSTGRES_USER=lumaindex
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# 5. Field encryption key  ⚠️  BACK THIS UP SEPARATELY
# ------------------------------------------------------------------------------
# Encrypts Google OAuth refresh tokens at rest (PRD §9, §32).
#
# Generate with:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#
# If you lose this key, every stored refresh token becomes undecryptable and
# every user must reconnect their Google Drive. Store it in a password manager,
# NOT only in a database backup — a backup containing both the ciphertext and
# the key protects you against disk loss but not against backup theft.
LUMA_FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# Optional: comma-separated older keys, newest first, kept only for decryption
# during a key rotation. Leave empty when not rotating.
LUMA_FIELD_ENCRYPTION_KEYS_LEGACY=


# ------------------------------------------------------------------------------
# 6. Google OAuth / Drive  (Phase 2 — leave blank until then)
# ------------------------------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID,
# type "Web application").
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must be registered verbatim as an Authorized redirect URI in the Google
# console, and must be reachable from the user's browser.
GOOGLE_OAUTH_REDIRECT_URI=https://luma.your-tailnet.ts.net/api/drive/oauth/callback

# ⚠️  Read `docs/google-oauth.md` before changing this. `drive.readonly` is a
# RESTRICTED scope: publishing an app that uses it requires Google verification
# plus an annual third-party security assessment. Staying in "Testing" mode
# avoids that but expires every refresh token after 7 days.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly


# ------------------------------------------------------------------------------
# 7. Email  (required for password reset — PRD §7)
# ------------------------------------------------------------------------------
# `console` prints reset links to the backend log instead of sending mail.
# Fine for a single-user tailnet instance; switch to `smtp` for real users.
#   console | smtp
LUMA_EMAIL_BACKEND=console

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=lumaindex@your-tailnet.ts.net


# ------------------------------------------------------------------------------
# 8. Registration policy
# ------------------------------------------------------------------------------
# PRD non-goal: public registration unless explicitly enabled. Keep this False
# and create accounts from Django Admin, or flip it on behind Tailscale.
LUMA_REGISTRATION_ENABLED=False


# ------------------------------------------------------------------------------
# 9. Storage & cache
# ------------------------------------------------------------------------------
# Paths INSIDE the backend container. Backed by named docker volumes.
LUMA_PDF_CACHE_DIR=/data/pdf-cache
LUMA_THUMBNAIL_DIR=/data/thumbnails

# Cache ceiling in bytes. Least-recently-used entries are evicted above this.
# 10 GiB. Keep well under your free disk — a full disk takes Postgres down too.
LUMA_PDF_CACHE_MAX_BYTES=10737418240


# ------------------------------------------------------------------------------
# 10. Runtime tuning
# ------------------------------------------------------------------------------
# Rule of thumb: (2 * CPU cores) + 1.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Tag applied to built images. deploy.sh sets this per release so the
# previous release's images stay on disk and `deploy.sh rollback` works.
LUMA_IMAGE_TAG=latest

# Where Caddy is published on the host. The default binds to loopback only, so
# the sole way in is `tailscale serve`. Setting LUMA_BIND_ADDRESS to 0.0.0.0
# exposes LumaIndex to every network the host is attached to — including the
# public internet if it has a routable address. Leave it alone unless you have
# a firewall you trust more than this default.
LUMA_BIND_ADDRESS=127.0.0.1
CADDY_HTTP_PORT=8080


# ------------------------------------------------------------------------------
# 11. First-run superuser (optional)
# ------------------------------------------------------------------------------
# If both are set, the backend creates this account on first start and then
# ignores them. Blank them out afterwards — or just run:
#   ./deploy/deploy.sh createsuperuser
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
